# Store text with LF endings on every OS; Windows checkouts are converted as needed.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Datasets are compared byte for byte by their checksums, so keep them exactly as downloaded.
datasets/**/*.txt -text
datasets/**/*.csv -text

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.eps binary
datasets/**/*.jsonl -text
